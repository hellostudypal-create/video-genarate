{
  "name": "quiz-video-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion preview src/index.tsx --log-level=warn",
    "render": "node scripts/render-sample.mjs",
    "render:all": "node scripts/render-all.mjs",
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "check": "npm run build && npm run lint"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.335",
    "@remotion/renderer": "^4.0.335",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.335"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.523",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3"
  }
}
